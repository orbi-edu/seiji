<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sudo install -m 644 deploy/dev.seiji.daemon.plist /Library/LaunchDaemons/ && sudo launchctl bootstrap system /Library/LaunchDaemons/dev.seiji.daemon.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.seiji.daemon</string>
  <key>UserName</key>
  <string>seiji</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/seiji</string>
    <string>serve</string>
    <string>--config</string>
    <string>/usr/local/etc/seiji/seiji.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>seiji=info</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ExitTimeOut</key>
  <integer>120</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/seiji.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/seiji.log</string>
</dict>
</plist>
